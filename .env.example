# Copy to .env for local development. Do not overwrite an existing private .env.
# Required: supply your own password (12-72 bytes). There is no default password.
APP_ADMIN_PASSWORD=
APP_LISTEN=127.0.0.1:8080
APP_DATA_DIR=data
# Set this to the exact HTTPS origin behind a reverse proxy, without a path.
APP_PUBLIC_URL=
APP_ALLOW_PRIVATE_FEEDS=false

# Optional: use the Web UI to bind PAT, or set ONE of these external sources.
# FILE takes priority over the environment, which takes priority over UI storage.
PIKPAK_TOKEN=
PIKPAK_TOKEN_FILE=
APP_ADMIN_PASSWORD_FILE=
